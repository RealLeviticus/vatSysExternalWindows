<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RootNamespace>VatSysExternalWindows</RootNamespace>
    <AssemblyName>VatSysExternalWindows</AssemblyName>
    <Version>2.1.0.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ProgramFilesX86 Condition="'$(ProgramFilesX86)' == ''">C:\Program Files (x86)</ProgramFilesX86>
    <VatSysDir Condition="'$(VatSysDir)' == ''">$(ProgramFilesX86)\vatSys</VatSysDir>
    <VatSysExe Condition="'$(VatSysExe)' == ''">$(VatSysDir)\bin\vatSys.exe</VatSysExe>
    <VatSysProfilePluginsDir Condition="'$(VatSysProfilePluginsDir)' == ''">$(UserProfile)\Documents\vatSys Files\Profiles\Australia\Plugins\VatSysExternalWindows</VatSysProfilePluginsDir>
    <OutputPath>$(VatSysProfilePluginsDir)</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="vatSys">
      <HintPath>$(VatSysExe)</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Colours.GetColourDX returns a SharpDX colour; vatSys ships the assembly -->
    <Reference Include="SharpDX.Mathematics">
      <HintPath>$(VatSysDir)\bin\SharpDX.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- The window page (HTML, CSS, JavaScript) is embedded so the plugin stays a single DLL -->
  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" LogicalName="Web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateVatSysReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(VatSysExe)')" Text="vatSys.exe not found at '$(VatSysExe)'. Set VatSysDir MSBuild property to your vatSys install root." />
  </Target>
</Project>
